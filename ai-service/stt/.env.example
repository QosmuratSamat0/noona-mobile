# STT Service Environment Configuration
# Copy to .env and fill in your values.

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# ── Whisper Model ─────────────────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v3
# For CPU: small gives the best accuracy/speed tradeoff for ru/kk/en
WHISPER_MODEL_SIZE=small

# Device: auto (detects CUDA, falls back to CPU) | cpu | cuda
WHISPER_DEVICE=auto

# Compute type: auto (int8 on CPU, float16 on GPU) | int8 | float16 | float32
WHISPER_COMPUTE_TYPE=auto

# Match to the number of vCPUs allocated to this container
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1

# ── Silero VAD ────────────────────────────────────────────────────────────────
VAD_ENABLED=true
# 0.5 is Silero's default; increase (0.7) for noisy environments
VAD_THRESHOLD=0.5

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=voice-input

# ── Storage ───────────────────────────────────────────────────────────────────
TMP_DIR=/tmp/noona_stt
