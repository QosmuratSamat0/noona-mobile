# General
ENV=local

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/noona?sslmode=disable

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me

# Server Configuration
ADDRESS=0.0.0.0:8080
TIMEOUT=15s
IDLE_TIMEOUT=60s

REDIS_URL=localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY_ID=admin
MINIO_SECRET_ACCESS_KEY=password
MINIO_USE_SSL=false

# STT microservice (Python faster-whisper) — gRPC
STT_GRPC_ADDR=localhost:50051
STT_REQUEST_TIMEOUT=120s

# Audio worker pool
AUDIO_WORKER_QUEUE=audio:jobs
AUDIO_WORKER_COUNT=2
