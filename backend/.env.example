# General
ENV=local

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/noona?sslmode=disable

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me

# Server Configuration
ADDRESS=0.0.0.0:8080
TIMEOUT=15s
IDLE_TIMEOUT=60s

REDIS_URL=localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY_ID=admin
MINIO_SECRET_ACCESS_KEY=password
MINIO_USE_SSL=false

# STT microservice (Python faster-whisper) — gRPC
STT_PROVIDER=grpc
STT_SERVICE_URL=http://localhost:8001
STT_GRPC_ADDR=localhost:50051
STT_REQUEST_TIMEOUT=10m
GROQ_API_KEY=
GROQ_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_STT_MODEL=whisper-large-v3-turbo

# LLM provider for chat/feedback: gemini, groq, or openrouter
LLM_PROVIDER=gemini
GROQ_LLM_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_LLM_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_LLM_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Noona AI

TTS_SERVICE_URL=http://localhost:8002
TTS_GRPC_ADDR=localhost:50052
TTS_REQUEST_TIMEOUT=120s


GEMINI_API_KEY=AIzaSyC_.....
GEMINI_MODEL=gemini-1.5-flash

# Audio worker pool
AUDIO_WORKER_QUEUE=audio:jobs
AUDIO_WORKER_COUNT=2
